# Exemple de configuration. Copier en `.env` et adapter, OU exporter ces
# variables dans l'environnement avant `npm start`.
# (Le projet lit process.env directement ; aucun chargeur .env n'est requis.)

# --- Réseau ---
PORT=3000

# --- Choix du SGBD : 'sqlite' (dev) ou 'mysql' (cible) ---
DB_DRIVER=sqlite

# --- SQLite (si DB_DRIVER=sqlite) ---
# CHEMIN_BDD=./server/db/file-attente.sqlite

# --- MySQL (si DB_DRIVER=mysql) ---
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DATABASE=file_attente

# --- Règles paramétrables ---
DELAI_ABANDON_MIN=5
